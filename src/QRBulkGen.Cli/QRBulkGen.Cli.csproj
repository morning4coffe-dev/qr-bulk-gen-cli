<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <RootNamespace>QRBulkGen.Cli</RootNamespace>
    <AssemblyName>qr-bulk</AssemblyName>
    <Version>1.0.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>qr-bulk</ToolCommandName>
    <PackageId>QRBulkGen.Cli</PackageId>
    <Authors>morning4coffe-dev</Authors>
    <Description>Offline, cross-platform QR codes from text, CSV, and pipelines. Export PNG, SVG, or printable PDF sheets.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/morning4coffe-dev/qr-bulk-gen-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/morning4coffe-dev/qr-bulk-gen-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>qr;qrcode;cli;csv;pdf;labels;offline</PackageTags>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fonts\NotoSans-Regular.ttf" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" CopyToOutputDirectory="PreserveNewest" Link="LICENSE.md" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" CopyToOutputDirectory="PreserveNewest" Link="NOTICE" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" CopyToOutputDirectory="PreserveNewest" Link="THIRD-PARTY-NOTICES.md" />
    <None Include="..\..\licenses\*.txt" Pack="true" PackagePath="licenses\" CopyToOutputDirectory="PreserveNewest" Link="licenses\%(Filename)%(Extension)" />
    <None Update="Fonts\OFL.txt" Pack="true" PackagePath="licenses\" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="QRBulkGen.Cli.Tests" />
  </ItemGroup>
</Project>
